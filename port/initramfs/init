#!/bin/busybox sh
# Rufus Cuff first-boot initramfs.
# Logs what the kernel found to /dev/kmsg (which lands in pstore), offers a shell on
# the USB CDC-ACM gadget (ttyGS0), draws a test pattern for the
# webcam, then reboots to Android after 120 s unless /tmp/stay exists.
# The USB gadget is g_serial (CDC-ACM): Windows binds it as "USB Serial Device (COMx)".

/bin/busybox --install -s /bin
export PATH=/bin

mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts

log() {
	echo "rufus-init: $*" > /dev/kmsg
	echo "rufus-init: $*" > /dev/tty0 2>/dev/null
}

log "userspace up at $(cut -d' ' -f1 /proc/uptime)s, kernel $(uname -r)"
log "cmdline: $(cat /proc/cmdline)"
log "mem: $(grep MemTotal /proc/meminfo)"
log "cpus: $(grep -c ^processor /proc/cpuinfo)"
log "block: $(ls /sys/block | tr '\n' ' ')"
log "mmcblk0 partitions: $(ls /sys/block/mmcblk0 2>/dev/null | grep -c mmcblk0p)"
log "udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
log "tty gadget: $(ls /dev/ttyGS* 2>/dev/null | tr '\n' ' ')"
log "net: $(ls /sys/class/net | tr '\n' ' ')"
log "fb0: $(cat /sys/class/graphics/fb0/name 2>/dev/null) $(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null)"
log "watchdog: $(cat /sys/class/watchdog/watchdog0/identity 2>/dev/null) timeout=$(cat /sys/class/watchdog/watchdog0/timeout 2>/dev/null)"

log "display: $(dmesg | grep -o "RDMA0 scanning.*" | head -1)"
# Wi-Fi: the vendor driver's own autostart runs before CONSYS has probed (-EPROBE_DEFER)
# and never retries, so it is off on the command line and started here instead. Wait for
# wlan0: the firmware is loaded from this initramfs, which is gone after switch_root.
echo 1 > /sys/module/mt6739_wlan/parameters/wlan_on 2>/dev/null
i=0
while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
log "wifi: wlan0 $(cat /sys/class/net/wlan0/address 2>/dev/null)"
log "battery: $(battery)"
log "backlight: $(cat /sys/class/backlight/*/brightness 2>/dev/null)/$(cat /sys/class/backlight/*/max_brightness 2>/dev/null)"

# The root filesystem is an ext4 image file in Android's /data (scripts/install-rootfs.sh),
# next to its extent map as Android's own ext4 reported it. /data is mounted read-only only
# to check that this kernel sees the same extents; then the image's blocks are mapped with
# device-mapper and mounted. Android's filesystem is never written. Any failure: stay here.
boot_rootfs() {
	data=$(grep -l "^PARTNAME=userdata$" /sys/class/block/*/uevent 2>/dev/null | head -1)
	data=/dev/$(basename "$(dirname "$data")")
	[ -b "$data" ] || { log "rootfs: no userdata partition"; return 1; }
	mkdir -p /android /newroot
	blockdev --setro "$data"
	if ! mount -t ext4 -o ro,noload "$data" /android; then
		blockdev --setrw "$data"
		log "rootfs: cannot mount $data read-only"
		return 1
	fi
	ok=0
	if [ ! -f /android/linux/rootfs.map ]; then
		log "rootfs: none installed"
	elif ! mapfile print /android/linux/rootfs.img > /tmp/rootfs.map; then
		log "rootfs: cannot map the image"
	elif ! cmp -s /tmp/rootfs.map /android/linux/rootfs.map; then
		log "rootfs: extents differ from Android's map, not using it"
	else
		ok=1
	fi
	# pupui theme (scripts/theme-push.sh): copied while /data is mounted, at most 16 MiB.
	rm -rf /tmp/theme
	if [ -d /android/linux/theme ] && [ "$(du -sk /android/linux/theme | cut -f1)" -le 16384 ]; then
		cp -r /android/linux/theme /tmp/theme && log "theme: $(ls /tmp/theme | wc -l) files"
	fi
	umount /android
	blockdev --setrw "$data"
	[ $ok = 1 ] || return 1

	dev=$(mapfile create rootfs "$data" < /tmp/rootfs.map) || { log "rootfs: mapping failed"; return 1; }
	magic=$(dd if="$dev" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
	label=$(dd if="$dev" bs=1 skip=1144 count=10 2>/dev/null)
	if [ "$magic" != 53ef ] || [ "$label" != rufus-root ]; then
		log "rootfs: $dev is not our filesystem ($magic $label)"
		return 1
	fi
	mount -t ext4 -o rw,noatime "$dev" /newroot || { log "rootfs: mount failed"; return 1; }
	[ -x /newroot/sbin/init ] || { log "rootfs: no /sbin/init"; umount /newroot; return 1; }
	# The theme follows /data/linux/theme: removing that folder removes the theme.
	rm -rf /newroot/var/lib/rufus/theme
	[ -d /tmp/theme ] && cp -r /tmp/theme /newroot/var/lib/rufus/theme
	log "rootfs: $dev ($(($(wc -l < /tmp/rootfs.map) - 1)) extents), switching root"
	for d in dev proc sys; do mount --move /$d /newroot/$d; done
	return 0
}

if boot_rootfs; then
	exec switch_root /newroot /sbin/init
fi

# No root filesystem: the kid UI from here, a shell, and back to Android after 120 s.
# Holding the second button for 3 s in the UI reboots to Android.
[ -d /tmp/theme ] && mkdir -p /var/lib/rufus && cp -r /tmp/theme /var/lib/rufus/theme
pupui > /dev/kmsg 2>&1 &


( while true; do
	[ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
	sleep 1
done ) &

i=120
while [ $i -gt 0 ] && [ ! -e /tmp/stay ]; do
	[ $((i % 20)) -eq 0 ] && log "back to Android in ${i}s (touch /tmp/stay to keep Linux)"
	sleep 1
	i=$((i - 1))
done

if [ ! -e /tmp/stay ]; then
	# Android is in "boot" when LK started us from "recovery" (atag,boot mode 2), else in
	# "recovery" (Linux in "boot"): a plain reboot would just start Linux again.
	mode=$(od -An -tu1 -j8 -N1 /proc/device-tree/chosen/atag,boot 2>/dev/null | tr -d ' ')
	log "rebooting to Android (LK boot mode ${mode:-?})"
	sync
	[ "$mode" = 2 ] || rufus-reboot recovery
	reboot -f
fi
log "staying in Linux"
while true; do sleep 3600; done
