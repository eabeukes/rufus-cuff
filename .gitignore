# Never publish: this watch's partition dumps (IMEI, MACs, RF calibration, keys).
backup-*/
hw/pstore-region.bin
hw/dt.tar
hw/live.dtb
hw/live.dts

# MediaTek firmware blobs and this watch's Wi-Fi NVRAM (copied from the device, not ours).
port/firmware/*
!port/firmware/README.txt

# Build outputs and device images.
images/
tools/SP_Flash_Tool_*/
tools/rb-test/

# Webcam captures, device logs (Android logs, network names), benchmark output.
cam/
logs/
bench/

# Local package snapshots.
packages-*.txt

# Kid UI art generated by port/pupui/gen_assets.py.
port/pupui/assets.[ch]
port/pupui/preview-*.png
